# Copy to a protected runtime environment; never commit real values.
PROMETHEUS_URL=https://prometheus.internal.example
PROMETHEUS_CLUSTER_ID=pilot-01
PROMETHEUS_CLUSTER_LABEL=cluster
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=30
PROMETHEUS_TIMEOUT_MS=8000
PROMETHEUS_BEARER_TOKEN=replace-with-server-side-prometheus-token

# Adapter-to-gateway credential. The browser must never receive this value.
DASHBOARD_API_TOKEN=replace-with-at-least-24-random-characters

# Optional exact HTTPS origin for an already-authenticated trusted UI.
# CORS is disabled when this is unset. CORS is not authentication.
# DASHBOARD_ORIGIN=https://dashboard.example.com

# Validate each source mapping against the actual exporter / vLLM version.
# These defaults are illustrative candidate mappings, not verified pilot facts.
# PROMETHEUS_GPU_UTILIZATION_METRIC=DCGM_FI_DEV_GPU_UTIL
# PROMETHEUS_GPU_VRAM_USED_METRIC=DCGM_FI_DEV_FB_USED
# PROMETHEUS_GPU_VRAM_USED_UNIT=MiB
# PROMETHEUS_GPU_TEMPERATURE_METRIC=DCGM_FI_DEV_GPU_TEMP
# PROMETHEUS_GPU_POWER_METRIC=DCGM_FI_DEV_POWER_USAGE
# PROMETHEUS_OUTPUT_TOKENS_METRIC=vllm:generation_tokens_total
# PROMETHEUS_TTFT_HISTOGRAM=vllm:time_to_first_token_seconds
# PROMETHEUS_ITL_HISTOGRAM=vllm:inter_token_latency_seconds
# PROMETHEUS_KV_CACHE_METRIC=vllm:kv_cache_usage_perc
# PROMETHEUS_KV_CACHE_SOURCE_UNIT=ratio
# PROMETHEUS_LABEL_ALLOWLIST=gpu,gpu_id,gpu_uuid,UUID,node,hostname,model,model_name,replica

# Bind locally by default; expose only behind a trusted auth/RBAC gateway.
HOST=127.0.0.1
PORT=8787
